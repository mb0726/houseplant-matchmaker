# Anthropic API key for the LLM calls.
# Get yours at https://console.anthropic.com/
# In production, set this in Vercel's environment variables, not in this file.
ANTHROPIC_API_KEY=

# Demo override key. A long random string. When this is passed as a URL parameter
# (?demo_key=...), it bypasses per-IP rate limits but NOT total budget caps.
# Used for live demos to hiring managers without hitting your own rate limits.
DEMO_KEY=

# Daily budget cap in dollars. The total API spend allowed per day across all users.
# When hit, the demo gracefully degrades to a "taking a breather" message.
DAILY_BUDGET_USD=5

# Monthly budget cap in dollars. Same behavior as daily, but for the calendar month.
MONTHLY_BUDGET_USD=50
